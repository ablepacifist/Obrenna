# Copy to .env to override defaults. All optional.

# Where local-first data lives (uploads, generated artifacts, SQLite db).
# OBRENNA_DATA_DIR=./data

# SQLAlchemy database URL (defaults to sqlite in the data dir).
# DATABASE_URL=sqlite:///./data/app.db

# Comma-separated allowed CORS origins (the Vite dev server).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Web search API keys (optional — DuckDuckGo is default, no key needed).
# BRAVE_SEARCH_API_KEY=
# SERPAPI_API_KEY=
