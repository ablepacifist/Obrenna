{
  "$schema_version": "1.0",
  "$description": "Deterministic hardware-to-model-plan catalog for a local-first AI workspace app. The resolver walks gpu_tiers.plans (or cpu_only_tiers.plans if no qualifying GPU) in descending rank order and returns the FIRST plan whose requires block is fully satisfied by the probed hardware fingerprint. This file is the single source of truth for model selection.",
  "model_definitions": {
    "$description": "Canonical model metadata, referenced by id from plans below.",
    "qwen3.5-0.8b": {
      "family": "qwen3.5",
      "params_b": 0.8,
      "role_class": ["utility"]
    },
    "qwen3.5-4b": {
      "family": "qwen3.5",
      "params_b": 4,
      "role_class": ["orchestrator"]
    },
    "qwen3.5-9b": {
      "family": "qwen3.5",
      "params_b": 9,
      "role_class": ["orchestrator"]
    },
    "qwen3.5-27b": {
      "family": "qwen3.5",
      "params_b": 27,
      "role_class": ["orchestrator"]
    },
    "qwen3.6-35b-a3b": {
      "family": "qwen3.6",
      "params_b": 35,
      "active_params_b": 3,
      "moe": true,
      "role_class": ["orchestrator"],
      "notes": "MoE — only ~3B active params per token."
    },
    "gpt-oss-20b": {
      "family": "gpt-oss",
      "params_b": 21,
      "active_params_b": 3.6,
      "moe": true,
      "role_class": ["orchestrator-optional"],
      "notes": "OpenAI open-weight MoE. Evaluated and rejected as default due to hallucination on document-grounded tasks."
    },
    "granite4.0-h-micro-3b": {
      "family": "granite4-h",
      "params_b": 3,
      "moe": false,
      "hybrid_mamba": true,
      "role_class": ["summarizer"],
      "notes": "Hybrid Mamba-2/Transformer. Constant memory as context grows."
    },
    "granite4.0-h-tiny-7b-a1b": {
      "family": "granite4-h",
      "params_b": 7,
      "active_params_b": 1,
      "moe": true,
      "hybrid_mamba": true,
      "role_class": ["summarizer"],
      "notes": "Hybrid MoE, 7B total / ~1B active."
    },
    "_quant_weight_table_gb": {
      "$description": "MEASURED GGUF/MLX file sizes in GB, not theoretical estimates. Use this for all VRAM/RAM budgeting.",
      "qwen3.5-0.8b": {
        "Q6_K": 0.7,
        "Q8_0": 0.85
      },
      "qwen3.5-4b": {
        "Q4_K_M": 2.4,
        "Q5_K_M": 3.0,
        "Q6_K": 3.4
      },
      "qwen3.5-9b": {
        "Q4_K_M": 5.5,
        "Q5_K_M": 6.5,
        "Q6_K": 7.4,
        "Q8_0": 9.6
      },
      "qwen3.5-27b": {
        "Q4_K_M": 16.5
      },
      "qwen3.6-35b-a3b": {
        "Q4_K_M": 21.4,
        "Q5_K_M": 24.8
      },
      "gpt-oss-20b": {
        "Q4_K_M": 12.0,
        "Q6_K": 18.5
      },
      "granite4.0-h-micro-3b": {
        "Q5_K_M": 2.0,
        "Q6_K": 2.3
      },
      "granite4.0-h-tiny-7b-a1b": {
        "Q4_K_M": 4.2,
        "Q5_K_M": 5.0
      }
    },
    "_kv_cache_gb_per_1k_tokens": {
      "$description": "Marginal memory cost of 1000 tokens of KV cache at q8_0 KV quantization.",
      "qwen3.5-4b": 0.075,
      "qwen3.5-9b": 0.09,
      "qwen3.5-27b": 0.18,
      "qwen3.6-35b-a3b": 0.12,
      "gpt-oss-20b": 0.16
    }
  },
  "global_constants": {
    "$description": "Fixed overheads consumed by the fit() step.",
    "gpu_display_overhead_gb": 1.3,
    "gpu_framework_overhead_gb": 0.7,
    "gpu_usable_fraction_of_free_vram": 0.85,
    "ram_os_shell_overhead_gb": {
      "windows": 4.0,
      "macos": 3.0,
      "linux": 2.5
    },
    "ram_runtime_overhead_gb": 1.5,
    "ram_pdf_render_spike_gb": 2.5,
    "ram_safety_margin_gb": 1.5,
    "interactive_tok_s_floor_gpu": 8,
    "interactive_tok_s_floor_cpu_only": 5
  },
